{
  "name": "@dsh/heart",
  "version": "0.4.1",
  "description": "DSH 的「心」与「身体」：身体按宿主环境安装（手机/Windows/Linux），心是它自己写的本子。数据在用户主目录，插件只提供写入面。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "heart": "./bin/heart.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./store": {
      "default": "./lib/store.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "schema.json",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "heart",
    "memory",
    "notebook"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
